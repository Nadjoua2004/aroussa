# ============================================================================
# CONFIGURATION SUPABASE & SERVEUR EXPRESS
# Copiez ce fichier en ".env" et collez vos clés Supabase
# ============================================================================

# URL de votre projet Supabase (ex: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=
VITE_SUPABASE_URL=

# Clé publique Anon Supabase
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=

# Clé Service Role Supabase (Optionnelle - côté serveur Express uniquement pour l'import/admin)
SUPABASE_SERVICE_ROLE_KEY=

# Profil par défaut de la mariée (Sarah)
DEFAULT_BRIDE_PROFILE_ID=00000000-0000-0000-0000-000000000001

# Port local pour le serveur Express
PORT=5000

